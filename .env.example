REDIS_URL=redis://localhost:6379/0
BACKEND_URL=http://127.0.0.1:8000
POLLING_INTERVAL=10
MODEL_PATH=/path/to/qwen2.5-7b-instruct-Q4_K_M.gguf
KUBERNETES_AUDIT_LOG_PATH=/tmp/guardian-audit/audit.log
# One Guardian instance per customer cluster. Exports must come from that cluster.
GUARDIAN_CLUSTER_ID=client-dev
HUBBLE_EXPORT_PATH=/tmp/guardian-telemetry/hubble.jsonl
TETRAGON_EXPORT_PATH=/tmp/guardian-telemetry/tetragon.jsonl
TELEMETRY_MAX_EVENTS=50000
TELEMETRY_RETENTION_SECONDS=604800
# Set to an absolute, reviewed JSON boundary policy path:
# TELEMETRY_BOUNDARIES_FILE=/etc/guardian/boundaries.json

# Independent reader: does not consume the existing RBAC worker's audit cursor.
POD_AUDIT_EXPORT_PATH=/tmp/guardian-audit/audit.log
POD_INVENTORY_INTERVAL=60

# Continuous local model assessment (advisory only; no permission changes).
POD_REVIEW_ENABLED=true
POD_REVIEW_INTERVAL=60
POD_REVIEW_EVENT_LIMIT=8
POD_ALERT_THRESHOLD=7
LLM_GRADE_MAX_TOKENS=512

# Phase 1: durable governance and operator-issued scoped bearer credentials.
# No configured credential means no governance access. Never commit token values.
# Mount these on persistent/private storage; SQLite requires a single host.
GUARDIAN_GOVERNANCE_DB=data/guardian/governance.sqlite3
# GUARDIAN_AUTH_FILE=/etc/guardian/reviewers.auth.json
# Governed execution/positive approvals remain unavailable in phase 1.

# Independent evidence collector shares this ledger with the backend.
# Audit policy/source declaration are configured by the operator, not the model.
# GUARDIAN_ARCHIVE_DIRECTORY=/absolute/persistent/guardian/archive
# GUARDIAN_ARCHIVE_KEYS=/absolute/private/guardian/evidence.archive-keys.json
# Explicitly attest controlled consumer inventory only for the isolated pilot:
# GUARDIAN_CONTROLLED_NAMESPACES=guardian-demo

# Phase 3: shared lazy Ollama provider, dedicated analysis worker, preview only.
GUARDIAN_MODEL_PROFILE=agents/guardian/config/dev-laptop.toml
# Enable read-only drift/periodic analysis for previously created cases in these
# operator-approved namespaces; empty disables automatic scheduling.
# GUARDIAN_ANALYSIS_NAMESPACES=guardian-demo
# Run Ollama separately with OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1.
# The default profile requests qwen3.5:4b, 8192 context and no thinking output.
# MODEL_PATH applies only to the optional dev-llama-cpp.toml profile.
